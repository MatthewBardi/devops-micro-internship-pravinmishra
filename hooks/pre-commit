#!/bin/sh

MAX_FILE_SIZE=1048576
BLOCKED=0

echo "Running PR Ready pre-commit checks..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
  echo "No staged files to check."
  exit 0
fi

OLD_IFS=$IFS
IFS='
'

for FILE in $STAGED_FILES; do
  [ -f "$FILE" ] || continue

  FILE_SIZE=$(git show ":$FILE" | wc -c | tr -d ' ')

  if [ "$FILE_SIZE" -gt "$MAX_FILE_SIZE" ]; then
    echo "BLOCKED: oversized file detected: $FILE"
    BLOCKED=1
  fi

  if git diff --cached --no-color --unified=0 -- "$FILE" |
    grep -E '^\+[^+].*AKIA[0-9A-Z]{16}' > /dev/null 2>&1; then
    echo "BLOCKED: secret-like AWS access key detected in $FILE"
    BLOCKED=1
  fi
done

IFS=$OLD_IFS

if [ "$BLOCKED" -ne 0 ]; then
  echo "Commit rejected. Remove the risky content, stage the fix, and try again."
  exit 1
fi

echo "PR Ready checks passed."
exit 0