[web]
web1 ansible_host=WEB1_PUBLIC_IP
web2 ansible_host=WEB2_PUBLIC_IP

[app]
app1 ansible_host=APP1_PUBLIC_IP

[db]
db1 ansible_host=DB1_PRIVATE_IP ansible_ssh_common_args='-o ProxyJump=week09-web1'

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/week09-aws-ansible
ansible_connection=ssh
