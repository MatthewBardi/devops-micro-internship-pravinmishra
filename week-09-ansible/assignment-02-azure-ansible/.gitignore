
# Terraform working directory
**/.terraform/*

# Terraform state files (may contain sensitive information)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files with local values
*.tfvars
*.tfvars.json

# Terraform plan files
*.tfplan
tfplan
plan.out

# Terraform crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# SSH private keys and credentials
*.pem
*.key
id_rsa
id_ed25519
.env
.env.*

# Ansible retry files
*.retry

# Python virtual environments
.venv/
venv/

# Editor and operating system temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
